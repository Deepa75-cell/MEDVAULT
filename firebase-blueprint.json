{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Basic profile data for patients and doctors.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "specialty": { "type": "string", "description": "For doctors only" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "MedicalRecord": {
      "title": "Medical Record",
      "description": "A prescription or medical report uploaded by a patient.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["prescription", "report"] },
        "date": { "type": "string", "format": "date" },
        "fileUrl": { "type": "string" },
        "analysis": {
          "type": "object",
          "properties": {
            "summary": { "type": "string" },
            "keyFindings": { "type": "array", "items": { "type": "string" } },
            "medications": { "type": "array", "items": { "type": "string" } }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "title", "type", "date"]
    },
    "AccessShare": {
      "title": "Access Share",
      "description": "Permission granted by a patient to a doctor to view specific records.",
      "type": "object",
      "properties": {
        "recordId": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "sharedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recordId", "patientId", "doctorId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/records/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Medical records repository"
    },
    "/shares/{shareId}": {
      "schema": "AccessShare",
      "description": "Access control mappings"
    },
    "/reminders/{reminderId}": {
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "text": { "type": "string" },
          "time": { "type": "string" },
          "completed": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "description": "Patient reminders"
    }
  }
}
