rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    match /records/{recordId} {
      function canViewRecord() {
        return isOwner(resource.data.patientId) || 
               exists(/databases/$(database)/documents/shares/$(request.auth.uid + '_' + recordId));
      }
      allow read: if isSignedIn() && canViewRecord();
      allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
      allow update, delete: if isSignedIn() && isOwner(resource.data.patientId);
    }

    match /shares/{shareId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.patientId;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.patientId || request.auth.uid == resource.data.doctorId);
    }

    match /reminders/{r} {
      allow read, write: if isSignedIn();
    }
  }
}
